       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Condition — Pregnancy" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Charity's confirmed pregnancy, provisionally dated to a last menstrual period around New Year 2026, giving an estimated gestational age of 12–15 weeks." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
