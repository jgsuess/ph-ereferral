       ] ;
       fhir:name [ fhir:v "MedicationAdministration — Iron and Folic Acid" ] ;
       fhir:description [ fhir:v "Jane dispenses iron and folic acid (IFA) tablets to Charity with instructions to take one tablet daily, following WHO ANC guidelines for nutritional supplementation." ] ;
