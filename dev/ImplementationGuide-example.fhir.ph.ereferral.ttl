     fhir:resource ( [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "Bundle"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://jgsuess.github.io/ph-ereferral/Bundle/anc-contact-transaction-ex> ;
         fhir:reference [ fhir:v "Bundle/anc-contact-transaction-ex" ]
       ] ;
       fhir:name [ fhir:v "anc-contact-transaction-ex" ] ;
       fhir:description [ fhir:v "Nurse Jane conducts Charity's first antenatal care visit at\nBarangay Malusog Health Centre. This bundle captures the full clinical\nencounter: pregnancy confirmation, vital signs, chief complaint,\niron-and-folic-acid dispensing, laboratory orders, and the ultrasound\nreferral to Metro Imaging Centre — along with the task that tracks the\nreferral outcome." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v true
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "Condition"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://jgsuess.github.io/ph-ereferral/Condition/condition-pregnancy-ex> ;
         fhir:reference [ fhir:v "Condition/condition-pregnancy-ex" ]
       ] ;
       fhir:name [ fhir:v "Condition — Pregnancy" ] ;
       fhir:description [ fhir:v "Charity's confirmed pregnancy, provisionally dated to a last menstrual period around New Year 2026, giving an estimated gestational age of 12–15 weeks." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v true
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "Encounter"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://jgsuess.github.io/ph-ereferral/Encounter/encounter-anc-ex> ;
         fhir:reference [ fhir:v "Encounter/encounter-anc-ex" ]
       ] ;
       fhir:name [ fhir:v "Encounter — First Antenatal Care Contact" ] ;
       fhir:description [ fhir:v "The counselling session (08:30–10:00) in which nurse Jane confirms Charity's pregnancy, records vital signs and clinical history, and initiates the referral." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v true
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
