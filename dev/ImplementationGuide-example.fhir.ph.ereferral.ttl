         fhir:reference [ fhir:v "Encounter/encounter-registration-ex" ]
       ] ;
       fhir:name [ fhir:v "Encounter — Registration" ] ;
       fhir:description [ fhir:v "A brief ambulatory encounter (08:00–08:15) in which clerk Abraham collects Charity's demographic information and registers her in the system." ] ;
