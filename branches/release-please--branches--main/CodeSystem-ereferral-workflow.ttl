  fhir:concept ( [
     fhir:code [ fhir:v "received" ] ;
     fhir:display [ fhir:v "Received" ] ;
     fhir:definition [ fhir:v "The receiving facility has acknowledged receipt of the referral and is reviewing whether it can take the case." ]
  ] [
